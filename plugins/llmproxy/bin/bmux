#!/usr/bin/env node
// bmux — @brainmux/llmproxy CLI entry. Runs the built CLI (dist/cli.js).
// During development run `npm run build` first, or use `tsx src/cli.ts`.
import("../dist/cli.js").catch((err) => {
  console.error("bmux: build missing? run `npm run build` in plugins/llmproxy. ", err?.message ?? err);
  process.exit(1);
});
