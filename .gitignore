# secrets — NEVER commit (public repo)
.env
.env.local
.env.*.local
*.pem
*.key

# state / data
data/
.brainmux/

# node
node_modules/
dist/
# ...except the llmproxy plugin's self-contained CLI bundle (esbuild, zod+yaml inlined),
# which ships with the plugin so a marketplace-from-git install runs with no build step
# and no node_modules (see Plan 2 spec §2). tsc output (dist/src, dist/test) stays ignored.
!plugins/llmproxy/dist/
plugins/llmproxy/dist/*
!plugins/llmproxy/dist/bmux.js
# same for the graphmux plugin's shipped bundle
!plugins/graphmux/dist/
plugins/graphmux/dist/*
!plugins/graphmux/dist/gmux.js
build/
*.tsbuildinfo
.npm/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# os / editor
.DS_Store
*.swp
.idea/
.vscode/
